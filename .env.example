# Copy to .env.local for `vercel dev`, and set the same two in the Vercel
# project (Settings -> Environment Variables) for the deployed site.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service-role key (Project Settings -> API -> service_role).
# Server-side only. It bypasses RLS, so it must never reach the browser —
# no NEXT_PUBLIC_ / VITE_ prefix, and never inline it in public/index.html.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Lets you run a second, separate scope off the same table,
# e.g. SCOPE_ROW_ID=workshop for a throwaway session. Defaults to "default".
# SCOPE_ROW_ID=default
